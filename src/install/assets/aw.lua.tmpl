-- aw.lua — Hammerspoon quick switcher for Agent Workspace (`aw`) sessions.
--
-- Generated by `aw install hammerspoon`. Re-running overwrites this file, so
-- keep your own tweaks in init.lua instead.
--
-- Bind it from init.lua:
--     require("aw").bind({ "cmd", "alt" }, "a")
--
-- Binary paths are substituted at install time on purpose: Hammerspoon does
-- not inherit your shell's PATH, and routing through a login shell would pick
-- up shell aliases (an oh-my-zsh `tmux` alias shadows the real binary, for
-- one). Absolute paths sidestep both.
--
-- Finding the right window relies on tmux publishing the session name as the
-- terminal title, which is what makes a Ghostty window identifiable:
--     set -g set-titles on
--     set -g set-titles-string "#S"
-- Without those two lines the switcher can still open a new window, but it
-- cannot recognise an existing one. See docs/hammerspoon.md.
--
-- Note on instances: macOS only passes `-e <command>` through to Ghostty via
-- `open -na`, and `-n` always starts a *second* Ghostty process. So windows
-- are enumerated across every running instance, not just one. The extra
-- instance exits by itself when its last window closes.

local AW = "@AW@"
local TMUX = "@TMUX@"
local OPEN = "/usr/bin/open"

local M = {}

-- Shell out and return stdout, or nil plus the output on failure.
local function sh(cmd)
  local out, ok = hs.execute(cmd)
  if ok then
    return out
  end
  return nil, out
end

-- Single-quote for /bin/sh. Pane ids (`%25`) and session names are ours, but
-- a workspace name is user-supplied and reaches the shell from here.
local function q(s)
  return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

-- The aw-managed agent panes active in the last 24 hours, newest first —
-- exactly what `aw switch` shows in the terminal.
local function panes()
  local out = sh(AW .. " switch --json")
  if not out then
    return {}
  end
  local ok, rows = pcall(hs.json.decode, out)
  if not ok or type(rows) ~= "table" then
    return {}
  end
  return rows
end

-- Every attached tmux client as { tty, session }.
--
-- Fields are separated by `|` rather than a tab: a tab has to survive Lua
-- source, the shell, and tmux's own format parser, and it only takes one of
-- them to eat it for every line to stop matching — which silently disables
-- window reuse, because no client is ever found.
local function clients()
  local out = sh(TMUX .. " list-clients -F '#{client_tty}|#{client_session}'")
  local list = {}
  for line in tostring(out or ""):gmatch("[^\n]+") do
    local tty, session = line:match("^([^|]+)|(.+)$")
    if tty then
      list[#list + 1] = { tty = tty, session = session }
    end
  end
  return list
end

-- The Ghostty window whose title is `title`, across every running instance.
--
-- With set-titles-string "#S" a tmux-hosted window's title is its session
-- name, so this is an exact match rather than a guess: non-tmux windows title
-- themselves after the cwd or the running program, and the titles we search
-- for came from tmux itself, so the two can't collide.
local function ghostty_window(title)
  for _, app in ipairs(hs.application.applicationsForBundleID("com.mitchellh.ghostty")) do
    for _, w in ipairs(app:allWindows()) do
      if w:title() == title then
        return w
      end
    end
  end
  return nil
end

-- Pick the Ghostty window to reuse: one already showing the target session
-- if there is one (then only the pane changes), else any window that is a
-- tmux client (we steer it to the target).
local function reusable(session)
  local cs = clients()
  for _, c in ipairs(cs) do
    if c.session == session then
      local w = ghostty_window(c.session)
      if w then
        return c, w
      end
    end
  end
  for _, c in ipairs(cs) do
    local w = ghostty_window(c.session)
    if w then
      return c, w
    end
  end
  return nil, nil
end

-- Focus the agent in `row`, reusing a Ghostty window when one is attached.
function M.jump(row)
  local client, window = reusable(row.session)
  if client then
    window:focus()
    sh(TMUX .. " switch-client -c " .. q(client.tty) .. " -t " .. q(row.pane_id))
    sh(TMUX .. " select-pane -t " .. q(row.pane_id))
    return
  end

  -- Nothing attached anywhere. Point the session at the right window and
  -- pane *first* — both work with no client attached — so the new Ghostty
  -- window lands on the pane the moment it attaches.
  sh(TMUX .. " select-window -t " .. q(row.pane_id))
  sh(TMUX .. " select-pane -t " .. q(row.pane_id))
  -- `-e` consumes the *rest of argv* as the command and its arguments, so each
  -- token has to arrive as its own word. Quoting the whole command into a
  -- single argument makes Ghostty try to exec that entire string as a filename
  -- ("login: tmux attach -t 'aw-x': No such file or directory").
  sh(OPEN .. " -na Ghostty.app --args -e " .. TMUX .. " attach -t " .. q(row.session))
end

-- Status presentation.
--
-- The dots are drawn, not borrowed. AppKit's `NSStatusAvailable` family is a
-- set of small bitmaps meant for the menu bar, so a chooser row scales them up
-- and they turn soft. `hs.canvas` renders at the display's backing scale, which
-- stays sharp and lets the colours match the terminal dashboard: red wants
-- your attention, amber is busy, green is done.
-- Colours mirror `dash::render::shown_rgb`, the one palette every surface uses.
local STATUS = {
  waiting = { label = "waiting", system = "NSStatusUnavailable",
              color = { red = 0.973, green = 0.318, blue = 0.286 } },
  working = { label = "working", system = "NSStatusPartiallyAvailable",
              color = { red = 0.824, green = 0.600, blue = 0.133 } },
  stalled = { label = "stalled", system = "NSStatusPartiallyAvailable",
              color = { red = 0.737, green = 0.455, blue = 0.871 } },
  idle = { label = "idle", system = "NSStatusAvailable",
           color = { red = 0.247, green = 0.725, blue = 0.314 } },
}

-- `shown` is what the pane can honestly be said to be doing; `status` is only
-- what it last claimed. Older servers send no `shown`, so fall back.
local function shown_of(r)
  return r.shown or r.status
end

-- Canvas points. Render generously and let the chooser scale *down* — a
-- downsample stays crisp where an upsample does not.
local DOT_PT = 36
local DOT_CACHE = {}

-- Spinner geometry. A `working` row gets a rotating arc instead of a still pip,
-- because "working" is the one status that means something is happening right
-- now. Waiting and idle hold still on purpose: motion should mean motion.
--
-- `hs.chooser` rows take a static `hs.image`, so nothing animates itself. The
-- movement comes from rebuilding the choices on a timer (see `M.show`); these
-- are the frames it cycles through.
-- Two separate knobs, and it is worth keeping them separate: `SPIN_INTERVAL`
-- is how often the chooser is rebuilt, `SPIN_FRAMES` is how many steps make a
-- full turn. Their product is the period, so rotation speed and smoothness are
-- independent.
--
-- 40 steps at 25 Hz is 9° per frame and one revolution per 1.6 s. The first
-- version used 12 steps at 12.5 Hz: the same visual complaint could have come
-- from either number, but at 30° per frame the step size was the problem, not
-- the tick rate. Measured on an M-series Mac with 12 rows, the rebuild sustains
-- 50 Hz without falling behind, so 25 Hz is a deliberate choice rather than a
-- ceiling — a spinner gains nothing from the other half.
local SPIN_FRAMES = 40
local SPIN_INTERVAL = 0.04
local SPIN_SWEEP = 260

-- A filled pip inside a translucent ring of the same hue, or — when `frame` is
-- given — a rotating arc in that hue.
local function draw_dot(spec, frame)
  local c = spec.color
  local mid = DOT_PT / 2
  local canvas = hs.canvas.new({ x = 0, y = 0, w = DOT_PT, h = DOT_PT })
  if frame then
    -- `arcRadii = false` keeps it an arc: the default closes the path back
    -- through the centre and fills in a pac-man wedge.
    local start = (frame / SPIN_FRAMES) * 360
    canvas:appendElements({
      type = "arc",
      action = "stroke",
      center = { x = mid, y = mid },
      radius = DOT_PT * 0.29,
      startAngle = start,
      endAngle = start + SPIN_SWEEP,
      arcRadii = false,
      strokeColor = c,
      strokeWidth = DOT_PT * 0.12,
      strokeCapStyle = "round",
    })
  else
    canvas:appendElements({
      type = "circle",
      action = "stroke",
      center = { x = mid, y = mid },
      radius = DOT_PT * 0.34,
      strokeColor = { red = c.red, green = c.green, blue = c.blue, alpha = 0.30 },
      strokeWidth = DOT_PT * 0.07,
    }, {
      type = "circle",
      action = "fill",
      center = { x = mid, y = mid },
      radius = DOT_PT * 0.21,
      fillColor = c,
    })
  end
  local image = canvas:imageFromCanvas()
  canvas:delete() -- offscreen scaffolding; don't leave it around
  return image
end

-- `frame` nil means the still dot. Every frame is drawn once and kept: twelve
-- small images is nothing, and redrawing them twelve times a second would not
-- be.
local function status_dot(status, frame)
  local spec = STATUS[status]
  if not spec then
    return nil
  end
  local key = status .. ":" .. tostring(frame or "still")
  if DOT_CACHE[key] == nil then
    -- `false` marks "tried and failed" so a broken lookup is attempted once
    -- rather than on every keystroke. A row without an icon is survivable; a
    -- traceback here would take the whole picker down.
    local ok, img = pcall(draw_dot, spec, frame)
    if not ok or not img then
      local ok2, sys = pcall(hs.image.imageFromName, spec.system)
      img = ok2 and sys or nil
    end
    DOT_CACHE[key] = img or false
  end
  return DOT_CACHE[key] or nil
end

-- What to show as the row's headline.
--
-- `name` is the tmux window name, which is usually the agent's own title (a
-- renamed Claude session, a subagent name). When it degenerates to the bare
-- agent type it says nothing useful, so fall back to the workspace, which
-- always identifies the work.
local function headline(r)
  local t = r.name
  if t == nil or t == "" or t == r.agent then
    return r.workspace
  end
  return t
end

-- Show the chooser. Text stays plain so the built-in filter matches it, and
-- everything searchable (status word, workspace, agent) is in the subtitle.
function M.show()
  local rows = panes()
  if #rows == 0 then
    hs.alert.show("aw · nothing active in the last 24h")
    return
  end

  -- The frame every `working` row is currently drawn at. Closed over by
  -- `build`, so bumping it and refreshing is the whole animation.
  local frame = 0
  local spinning = false
  for _, r in ipairs(rows) do
    if shown_of(r) == "working" then
      spinning = true
      break
    end
  end

  -- A function rather than a table, which is what lets
  -- `refreshChoicesCallback` re-run it. The rows themselves are fetched once
  -- and reused: re-reading `aw switch --json` on every frame would reorder the
  -- list under the cursor while you are trying to pick from it.
  local function build()
    local choices = {}
    for _, r in ipairs(rows) do
      local shown = shown_of(r)
      local spec = STATUS[shown] or STATUS.idle
      -- `N spawned` says this row stands for a group without listing the group.
      local extra = (r.spawned or 0) > 0 and string.format("  ·  %d spawned", r.spawned) or ""
      choices[#choices + 1] = {
        text = headline(r),
        subText = string.format("%s  ·  %s  ·  %s  ·  %s%s",
          spec.label, r.workspace, r.agent, r.age, extra),
        -- `shown`, not `r.status`: the label right next to it is derived, so a
        -- stalled pane used to get the working dot beside the word "stalled".
        image = status_dot(shown, shown == "working" and frame or nil),
        pane_id = r.pane_id,
        session = r.session,
      }
    end
    return choices
  end

  local chooser = hs.chooser.new(function(choice)
    if choice then
      M.jump(choice)
    end
  end)
  chooser:choices(build)
  -- Everything past `choices` is optional. Wrapped together, searchSubText
  -- first, so that if any setter is missing in some Hammerspoon version the
  -- picker still opens rather than dying on a traceback.
  pcall(function()
    -- Off by default, which is why typing a workspace name used to match
    -- nothing: only the headline was ever searched.
    chooser:searchSubText(true)
    chooser:bgDark(true)
    chooser:fgColor({ red = 0.93, green = 0.94, blue = 0.96 })
    chooser:subTextColor({ red = 0.58, green = 0.62, blue = 0.70 })
    chooser:width(34)
    chooser:rows(math.min(#rows, 12))
    chooser:placeholderText("agent, workspace, or status")
  end)
  chooser:show()

  -- Started after `show`, because the tick stops itself the moment the chooser
  -- is not visible and before `show` it is not. That self-stop is also what
  -- keeps a stray timer from ticking forever inside a Hammerspoon that stays
  -- running for weeks.
  if spinning then
    local timer
    timer = hs.timer.doEvery(SPIN_INTERVAL, function()
      if not chooser:isVisible() then
        timer:stop()
        return
      end
      frame = (frame + 1) % SPIN_FRAMES
      -- `true` re-applies the current query, so a refresh mid-typing does not
      -- throw away what you have typed. The selected row is index-based and
      -- survives a rebuild, but restore it explicitly rather than trusting the
      -- table view to keep its highlight.
      local row = chooser:selectedRow()
      chooser:refreshChoicesCallback(true)
      chooser:selectedRow(row)
    end)
  end
end

-- Convenience wrapper so init.lua stays a one-liner.
function M.bind(mods, key)
  return hs.hotkey.bind(mods, key, M.show)
end

return M
